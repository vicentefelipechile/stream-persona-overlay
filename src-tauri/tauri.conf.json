{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stream Persona Overlay",
  "version": "0.6.0",
  "identifier": "dev.vicentefelipechile.stream-persona-overlay",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Stream Persona — Panel",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      },
      {
        "label": "overlay",
        "title": "Stream Overlay (OBS)",
        "url": "overlay.html",
        "transparent": true,
        "width": 1920,
        "height": 1080,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["resources/guest_open.png", "resources/guest_closed.png"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
